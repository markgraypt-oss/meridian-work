# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Git history is not needed in the production image (~2.4 GB savings).
.git

# Dev-only backup files.
.migration-backup

# Build-time source assets — already bundled into dist by the build step.
attached_assets
